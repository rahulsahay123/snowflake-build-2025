import pandas as pd
from snowflake.snowpark.context import get_active_session

# Get Snowflake session
session = get_active_session()

print("="*60)
print("GENERATING 4 CLAIM TYPES FOR DIM_CLAIM_TYPE")
print("="*60)

# Define claim types data
print("\n[1/3] Creating claim type data...")

claim_types_data = [
    {
        'CLAIM_TYPE': 'Auto',
        'DESCRIPTION': 'Automobile accident and vehicle damage claims',
        'AVG_PROCESSING_DAYS': 25,
        'TYPICAL_MIN_AMOUNT': 500.00,
        'TYPICAL_MAX_AMOUNT': 50000.00
    },
    {
        'CLAIM_TYPE': 'Health',
        'DESCRIPTION': 'Medical treatment and healthcare claims',
        'AVG_PROCESSING_DAYS': 45,
        'TYPICAL_MIN_AMOUNT': 1000.00,
        'TYPICAL_MAX_AMOUNT': 100000.00
    },
    {
        'CLAIM_TYPE': 'Property',
        'DESCRIPTION': 'Home and property damage claims',
        'AVG_PROCESSING_DAYS': 60,
        'TYPICAL_MIN_AMOUNT': 2000.00,
        'TYPICAL_MAX_AMOUNT': 200000.00
    },
    {
        'CLAIM_TYPE': 'Life',
        'DESCRIPTION': 'Life insurance benefit claims',
        'AVG_PROCESSING_DAYS': 90,
        'TYPICAL_MIN_AMOUNT': 50000.00,
        'TYPICAL_MAX_AMOUNT': 500000.00
    }
]

# Create DataFrame
df_claim_types = pd.DataFrame(claim_types_data)

print(f"✓ Created {len(df_claim_types)} claim type records")
print(f"\nClaim Types:")
print(df_claim_types)

# Convert to Snowpark DataFrame
print(f"\n[2/3] Converting to Snowpark DataFrame...")
snowpark_df = session.create_dataframe(df_claim_types)

# Insert into DIM_CLAIM_TYPE table
print(f"\n[3/3] Inserting into DIM_CLAIM_TYPE table...")

try:
    # Write to table
    snowpark_df.write.mode("append").save_as_table("INSURANCE_CLAIMS_DB.DATA.DIM_CLAIM_TYPE")
    
    print(f"✓ Successfully inserted {len(df_claim_types)} rows into DIM_CLAIM_TYPE")
    
    # Verify insertion
    result = session.sql("SELECT COUNT(*) as row_count FROM INSURANCE_CLAIMS_DB.DATA.DIM_CLAIM_TYPE").collect()
    print(f"\n✓ Verification: DIM_CLAIM_TYPE now contains {result[0]['ROW_COUNT']} rows")
    
    # Show all records
    print(f"\nAll records from DIM_CLAIM_TYPE:")
    all_records = session.table("INSURANCE_CLAIMS_DB.DATA.DIM_CLAIM_TYPE")
    all_records.show()
    
    # Show summary statistics
    print(f"\nProcessing Days Summary:")
    summary = session.sql("""
        SELECT 
            CLAIM_TYPE,
            AVG_PROCESSING_DAYS,
            TYPICAL_MIN_AMOUNT,
            TYPICAL_MAX_AMOUNT
        FROM INSURANCE_CLAIMS_DB.DATA.DIM_CLAIM_TYPE
        ORDER BY AVG_PROCESSING_DAYS
    """)
    summary.show()
    
except Exception as e:
    print(f"✗ Error inserting data: {str(e)}")
    raise

print("\n" + "="*60)
print("CLAIM TYPE DATA LOAD COMPLETE!")
print("="*60)
