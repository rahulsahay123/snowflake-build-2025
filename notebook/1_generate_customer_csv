STREETS = ['Main St', 'Oak Ave', 'Maple Dr', 'Park Blvd', 'Cedar Ln', 'Elm St', 'Pine Rd', 'Washington Ave',
           'Broadway St', 'River Oaks Blvd', 'Memorial Dr', 'Westheimer Rd', 'University Blvd', 'Highland Ave',
           'Sunset Blvd', 'Congress Ave', 'Lamar Blvd', 'Commerce St', 'Market St', 'Division St']

RISK_PROFILES = ['Low', 'Medium', 'High']

def generate_customer_data(count=800):
    """Generate customer data with proper Texas distribution"""
    customers = []
    customer_id = 1
    
    for city, county, city_count in CITIES:
        for i in range(city_count):
            # Determine gender
            gender = random.choice(['Male', 'Female'])
            
            # Select name based on gender
            first_name = random.choice(MALE_NAMES if gender == 'Male' else FEMALE_NAMES)
            last_name = random.choice(LAST_NAMES)
            customer_name = f"{first_name} {last_name}"
            
            # Generate age (25-65)
            age = random.randint(25, 65)
            
            # Select ZIP and generate address
            zip_code = random.choice(ZIP_CODES.get(city, ['78000']))
            street_number = random.randint(1000, 9999)
            street = random.choice(STREETS)
            address = f"{street_number} {street}"
            
            # Risk profile (30% Low, 50% Medium, 20% High)
            risk_profile = random.choices(RISK_PROFILES, weights=[30, 50, 20])[0]
            
            # Customer since date (between 2017-2022)
            days_back = random.randint(365*3, 365*8)  # 3-8 years ago
            customer_since = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
            
            # Coastal property (TRUE only for specific Houston/coastal ZIP codes)
            coastal = True if zip_code in ['77401', '77058', '77059', '77034'] else False
            
            customer = {
                'CUSTOMER_ID': f'CUST-{customer_id:04d}',
                'CUSTOMER_NAME': customer_name,
                'AGE': age,
                'GENDER': gender,
                'LOCATION_CITY': city,
                'LOCATION_COUNTY': county,
                'LOCATION_ZIP': zip_code,
                'LOCATION_ADDRESS': address,
                'RISK_PROFILE': risk_profile,
                'CUSTOMER_SINCE': customer_since,
                'COASTAL_PROPERTY': coastal
            }
            
            customers.append(customer)
            customer_id += 1
    
    return customers

