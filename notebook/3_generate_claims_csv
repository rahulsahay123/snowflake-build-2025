def generate_claims_data(customers_df, policies_df, total_claims=3000):
    """Generate claims data with realistic patterns"""
    claims = []
    claim_id = 1
    
    # Separate policies by type
    policies_by_type = {
        ptype: policies_df[policies_df['POLICY_TYPE'] == ptype].to_dict('records')
        for ptype in ['Auto', 'Health', 'Property', 'Life']
    }
    
    for claim_type, count in CLAIM_TYPES:
        type_policies = policies_by_type[claim_type]
        
        if not type_policies:
            print(f"Warning: No {claim_type} policies found")
            continue
        
        for i in range(count):
            # Select a random policy of this type
            policy = random.choice(type_policies)
            customer_id = policy['CUSTOMER_ID']
            policy_id = policy['POLICY_ID']
            
            # Get customer details
            customer = customers_df[customers_df['CUSTOMER_ID'] == customer_id].iloc[0]
            
            # Generate claim date (between policy start and now)
            # Convert to datetime if it's a date object
            if isinstance(policy['START_DATE'], str):
                policy_start = datetime.strptime(policy['START_DATE'], '%Y-%m-%d')
            else:
                policy_start = datetime.combine(policy['START_DATE'], datetime.min.time())
            
            days_since_start = (datetime.now() - policy_start).days
            if days_since_start <= 0:
                days_since_start = 365
            
            claim_days_back = random.randint(0, min(days_since_start, 730))  # Max 2 years back
            claim_date = datetime.now() - timedelta(days=claim_days_back)
            
            # Report date (same day or next day)
            report_delay = random.randint(0, 1)
            report_date = claim_date + timedelta(days=report_delay)
            
            # Claim amount
            min_amt, max_amt = CLAIM_AMOUNTS[claim_type]
            claim_amount = round(random.uniform(min_amt, max_amt), 2)
            
            # Claim status
            claim_status = random.choices(
                list(CLAIM_STATUS_WEIGHTS.keys()),
                weights=list(CLAIM_STATUS_WEIGHTS.values())
            )[0]
            
            # Settlement amount (only for Approved claims)
            if claim_status == 'Approved':
                ratio_min, ratio_max = SETTLEMENT_RATIOS[claim_type]
                settlement_ratio = random.uniform(ratio_min, ratio_max)
                settlement_amount = round(claim_amount * settlement_ratio, 2)
            else:
                settlement_amount = 0.00
            
            # Processing days (based on claim type averages)
            base_days = {'Auto': 30, 'Health': 50, 'Property': 70, 'Life': 90}
            processing_days = random.randint(
                int(base_days[claim_type] * 0.7),
                int(base_days[claim_type] * 1.3)
            )
            
            # Settlement date (only for Approved claims)
            if claim_status == 'Approved':
                settlement_date = (report_date + timedelta(days=processing_days)).strftime('%Y-%m-%d')
            else:
                settlement_date = None
            
            # Weather related (10% chance for Auto/Property)
            weather_related = random.random() < 0.10 if claim_type in ['Auto', 'Property'] else False
            
            # Catastrophe code (if weather related and recent)
            catastrophe_code = None
            if weather_related and claim_days_back < 180:
                year = claim_date.year
                cat_num = random.randint(1, 12)
                catastrophe_code = f'CAT-{year}-{cat_num:03d}'
            
            # Loss location
            customer_city = customer['LOCATION_CITY']
            customer_county = customer['LOCATION_COUNTY']
            
            if claim_type == 'Life':
                loss_location_address = 'Not Applicable'
                loss_location_city = customer_city
                loss_location_county = customer_county
            else:
                # Select location based on customer city
                if customer_city in TEXAS_LOCATIONS:
                    location, county = random.choice(TEXAS_LOCATIONS[customer_city])
                else:
                    location = f'{random.randint(1000, 9999)} Main St'
                    county = customer_county
                
                loss_location_address = location
                loss_location_city = customer_city
                loss_location_county = county
            
            # Loss description
            desc_template = random.choice(LOSS_DESCRIPTIONS[claim_type])
            if claim_type != 'Life':
                loss_description = desc_template.format(loss_location_address)
            else:
                loss_description = desc_template
            
            # Adjuster ID
            adjuster_id = random.choice(ADJUSTERS[claim_type])
            
            claim = {
                'CLAIM_ID': f'CLM-{claim_date.year}-{claim_id:06d}',
                'POLICY_ID': policy_id,
                'CUSTOMER_ID': customer_id,
                'CLAIM_DATE': claim_date.strftime('%Y-%m-%d'),
                'REPORT_DATE': report_date.strftime('%Y-%m-%d'),
                'CLAIM_AMOUNT': claim_amount,
                'SETTLEMENT_AMOUNT': settlement_amount,
                'CLAIM_STATUS': claim_status,
                'CLAIM_TYPE': claim_type,
                'ADJUSTER_ID': adjuster_id,
                'LOSS_DESCRIPTION': loss_description,
                'LOSS_LOCATION_CITY': loss_location_city,
                'LOSS_LOCATION_COUNTY': loss_location_county,
                'LOSS_LOCATION_ADDRESS': loss_location_address,
                'WEATHER_RELATED': weather_related,
                'CATASTROPHE_CODE': catastrophe_code,
                'SETTLEMENT_DATE': settlement_date,
                'PROCESSING_DAYS': processing_days if claim_status == 'Approved' else None
            }
            
            claims.append(claim)
            claim_id += 1
    
    return claims

