# =====================================================
# GENERATE ALL UNSTRUCTURED DOCUMENTS - SINGLE SCRIPT
# Creates 30 documents: Medical, Police, Property, Adjuster reports
# =====================================================

import pandas as pd
import random
from datetime import datetime, timedelta
from snowflake.snowpark.context import get_active_session

session = get_active_session()

print("="*70)
print("GENERATING ALL UNSTRUCTURED DOCUMENTS")
print("="*70)

# Query high-value claims by type
print("\n[1/5] Querying claims by type...")

queries = {
    'medical': """
        SELECT c.CLAIM_ID, c.CLAIM_DATE, c.CLAIM_AMOUNT, c.LOSS_DESCRIPTION,
               c.LOSS_LOCATION_CITY, c.LOSS_LOCATION_ADDRESS, c.CLAIM_TYPE,
               cu.CUSTOMER_NAME, cu.AGE, cu.GENDER, cu.LOCATION_ADDRESS,
               cu.LOCATION_CITY, cu.LOCATION_ZIP, p.POLICY_ID
        FROM INSURANCE_CLAIMS_DB.DATA.FACT_CLAIMS c
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_CUSTOMER cu ON c.CUSTOMER_ID = cu.CUSTOMER_ID
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_POLICY p ON c.POLICY_ID = p.POLICY_ID
        WHERE (c.CLAIM_TYPE IN ('Health', 'Auto'))
            AND c.CLAIM_AMOUNT > 40000 AND c.CLAIM_STATUS = 'Approved'
        ORDER BY c.CLAIM_AMOUNT DESC LIMIT 10
    """,
    'police': """
        SELECT c.CLAIM_ID, c.CLAIM_DATE, c.CLAIM_AMOUNT, c.LOSS_DESCRIPTION,
               c.LOSS_LOCATION_CITY, c.LOSS_LOCATION_ADDRESS,
               cu.CUSTOMER_NAME, cu.AGE, cu.LOCATION_ADDRESS, p.POLICY_ID
        FROM INSURANCE_CLAIMS_DB.DATA.FACT_CLAIMS c
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_CUSTOMER cu ON c.CUSTOMER_ID = cu.CUSTOMER_ID
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_POLICY p ON c.POLICY_ID = p.POLICY_ID
        WHERE c.CLAIM_TYPE = 'Auto' AND c.CLAIM_AMOUNT > 30000
            AND c.CLAIM_STATUS = 'Approved'
        ORDER BY c.CLAIM_AMOUNT DESC LIMIT 8
    """,
    'property': """
        SELECT c.CLAIM_ID, c.CLAIM_DATE, c.CLAIM_AMOUNT, c.LOSS_DESCRIPTION,
               c.LOSS_LOCATION_CITY, c.LOSS_LOCATION_ADDRESS, c.WEATHER_RELATED,
               cu.CUSTOMER_NAME, cu.LOCATION_ADDRESS, p.POLICY_ID, p.COVERAGE_AMOUNT
        FROM INSURANCE_CLAIMS_DB.DATA.FACT_CLAIMS c
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_CUSTOMER cu ON c.CUSTOMER_ID = cu.CUSTOMER_ID
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_POLICY p ON c.POLICY_ID = p.POLICY_ID
        WHERE c.CLAIM_TYPE = 'Property' AND c.CLAIM_AMOUNT > 50000
            AND c.CLAIM_STATUS = 'Approved'
        ORDER BY c.CLAIM_AMOUNT DESC LIMIT 6
    """,
    'adjuster': """
        SELECT c.CLAIM_ID, c.CLAIM_DATE, c.CLAIM_AMOUNT, c.LOSS_DESCRIPTION,
               c.CLAIM_TYPE, c.ADJUSTER_ID, c.SETTLEMENT_AMOUNT,
               cu.CUSTOMER_NAME, p.POLICY_ID
        FROM INSURANCE_CLAIMS_DB.DATA.FACT_CLAIMS c
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_CUSTOMER cu ON c.CUSTOMER_ID = cu.CUSTOMER_ID
        INNER JOIN INSURANCE_CLAIMS_DB.DATA.DIM_POLICY p ON c.POLICY_ID = p.POLICY_ID
        WHERE c.CLAIM_AMOUNT > 40000 AND c.CLAIM_STATUS = 'Approved'
        ORDER BY c.CLAIM_AMOUNT DESC LIMIT 6
    """
}

claims_data = {}
for doc_type, query in queries.items():
    df = session.sql(query).to_pandas()
    claims_data[doc_type] = df
    print(f"  ✓ {doc_type.capitalize()}: {len(df)} claims")

# [2/5] Generate documents
print(f"\n[2/5] Generating documents...")

all_documents = []

# === MEDICAL REPORTS ===
