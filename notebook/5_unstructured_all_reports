    all_documents.append({
        'FILENAME': f"police_report_{claim['CLAIM_ID']}.txt",
        'CLAIM_ID': claim['CLAIM_ID'],
        'DOCUMENT_TYPE': 'Police Report',
        'CONTENT': content,
        'CREATED_DATE': datetime.now()
    })

print(f"  ✓ Generated {len(claims_data['police'])} police reports")

