print(f"  ✓ Generated {len(claims_data['adjuster'])} adjuster reports")

# [3/5] Store in table
print(f"\n[3/5] Storing documents in table...")

session.sql("""
    CREATE OR REPLACE TABLE INSURANCE_CLAIMS_DB.DATA.UNSTRUCTURED_DOCUMENTS (
        FILENAME VARCHAR(150),
        CLAIM_ID VARCHAR(30),
        DOCUMENT_TYPE VARCHAR(50),
        CONTENT VARCHAR(16777216),
        CREATED_DATE TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
    )
""").collect()

df_docs = pd.DataFrame(all_documents)
session.create_dataframe(df_docs).write.mode("append").save_as_table("INSURANCE_CLAIMS_DB.DATA.UNSTRUCTURED_DOCUMENTS")

print(f"✓ Stored {len(all_documents)} documents in table")

# [4/5] Verify
print(f"\n[4/5] Verification...")

summary = session.sql("""
    SELECT 
        DOCUMENT_TYPE,
        COUNT(*) as COUNT
    FROM INSURANCE_CLAIMS_DB.DATA.UNSTRUCTURED_DOCUMENTS
    GROUP BY DOCUMENT_TYPE
    ORDER BY DOCUMENT_TYPE
""")
summary.show()

