        'CLAIM_ID': claim['CLAIM_ID'],
        'DOCUMENT_TYPE': 'Property Assessment',
        'CONTENT': content,
        'CREATED_DATE': datetime.now()
    })

print(f"  ✓ Generated {len(claims_data['property'])} property assessments")

